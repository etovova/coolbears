{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "coolbears-devnet-rpc",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "DAILY_CREDIT_CAP": "20000" },
  "durable_objects": {
    "bindings": [{ "name": "RPC_GATE", "class_name": "RpcGate" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RpcGate"] }],
  "observability": { "enabled": false }
}

#include "stdlib.fc";

;; RELEASE CANDIDATE ONLY. Does not replace the existing mainnet package.
;; Final content is hidden by a cell-hash commitment until the reveal message.
const int REVEAL_AT = 1798761600;
const int SUPPLY = 4;
const int PRICE = 50000000;
const int PAYMENT = 100000000;
const int ITEM_VALUE = 50000000;
const int RESERVE_OP = 0x52535630;
const int MINT_OP = 0x4d494e54;
const int REVEAL_OP = 0x5245564c;
const int SWEEP_OP = 0x53574550;
const int KEEP_BALANCE = 20000000;

(slice, int, cell, cell, cell, slice, int, int, int) load_data() inline  {
  slice ds = get_data().begin_parse();
  var result = (ds~load_msg_addr(), ds~load_uint(64), ds~load_ref(), ds~load_ref(), ds~load_ref(), ds~load_msg_addr(), ds~load_uint(1), ds~load_uint(1), ds~load_uint(256));
  ds.end_parse();
  return result;
}
() save_data(slice owner, int next, cell content, cell item, cell royalty, slice treasury, int paused, int revealed, int commitment) impure inline  {
  set_data(begin_cell().store_slice(owner).store_uint(next,64).store_ref(content).store_ref(item).store_ref(royalty).store_slice(treasury).store_uint(paused,1).store_uint(revealed,1).store_uint(commitment,256).end_cell());
}
cell item_content(int index)  {
  builder b = begin_cell();
  b = b.store_uint(48 + ((index / 1000) % 10),8).store_uint(48 + ((index / 100) % 10),8).store_uint(48 + ((index / 10) % 10),8).store_uint(48 + (index % 10),8);
  return b.store_uint(0x2e6a736f6e,40).end_cell();
}
cell item_init(int index, cell code)  {
  cell data = begin_cell().store_uint(index,64).store_slice(my_address()).end_cell();
  return begin_cell().store_uint(0,2).store_dict(code).store_dict(data).store_uint(0,1).end_cell();
}
slice item_address(cell init)  {
  return begin_cell().store_uint(4,3).store_int(0,8).store_uint(cell_hash(init),256).end_cell().begin_parse();
}
() send_value(slice target, int amount, int mode) impure inline  {
  cell msg = begin_cell().store_uint(0x10,6).store_slice(target).store_coins(amount).store_uint(0,107).end_cell();
  send_raw_message(msg,mode);
}
() deploy_item(int index, cell code, slice recipient) impure  {
  cell init = item_init(index,code);
  cell body = begin_cell().store_slice(recipient).store_ref(item_content(index)).end_cell();
  cell msg = begin_cell().store_uint(0x18,6).store_slice(item_address(init)).store_coins(ITEM_VALUE).store_uint(7,108).store_ref(init).store_ref(body).end_cell();
  send_raw_message(msg,1);
}
() check_reveal(cell final_content, int revealed, int commitment) impure inline  {
  throw_unless(704,now() >= REVEAL_AT);
  throw_unless(708,revealed == 0);
  throw_unless(709,(commitment != 0) & (cell_hash(final_content) == commitment));
  slice cs = final_content.begin_parse();
  throw_unless(710,(slice_bits(cs) == 0) & (slice_refs(cs) == 2));
  slice collection = cs~load_ref().begin_parse();
  slice common = cs~load_ref().begin_parse();
  throw_unless(710,collection~load_uint(8) == 1);
  throw_unless(710,(slice_refs(common) == 0) & (slice_bits(common) > 0) & ((slice_bits(common) % 8) == 0));
}
;; Permissionless external reveal: no private wallet key is needed by a scheduler.
;; ALL checks precede ACCEPT. Wrong, early and repeated messages cannot spend gas
;; from the contract. Only the committed content can be installed, once.
() recv_external(slice body) impure  {
  throw_unless(711,body~load_uint(32) == REVEAL_OP);
  cell final_content = body~load_ref();
  body.end_parse();
  var (owner,next,content,item,royalty,treasury,paused,revealed,commitment) = load_data();
  check_reveal(final_content,revealed,commitment);
  accept_message();
  save_data(owner,next,final_content,item,royalty,treasury,paused,1,commitment);
}
() recv_internal(int msg_value, cell full, slice body) impure  {
  if (body.slice_empty?()) {
    return ();
  }
  slice envelope = full.begin_parse();
  int flags = envelope~load_uint(4);
  if (flags & 1) {
    return ();
  }
  slice sender = envelope~load_msg_addr();
  int op = body~load_uint(32);
  int query = body~load_uint(64);
  var (owner,next,content,item,royalty,treasury,paused,revealed,commitment) = load_data();
  if (op == 0x693d3950) {
    body.end_parse();
    cell response = begin_cell().store_uint(0x10,6).store_slice(sender).store_coins(0).store_uint(0,107).store_uint(0xa8cb00ad,32).store_uint(query,64).store_slice(royalty.begin_parse()).end_cell();
    send_raw_message(response,64);
    return ();
  }
  if ((op == MINT_OP) | (op == RESERVE_OP)) {
    int count = 1;
    if (op == RESERVE_OP) {
      throw_unless(706,equal_slices(sender,treasury));
      throw_unless(707,next == 0);
    }
    else {
      count = body~load_uint(8);
      throw_unless(700,paused == 0);
      throw_unless(705,next > 0);
    }
    body.end_parse();
    throw_unless(701,(count >= 1) & (count <= 50));
    throw_unless(702,next + count <= SUPPLY);
    throw_unless(703,msg_value >= count * PAYMENT);
    int old_balance = max(0,pair_first(get_balance()) - msg_value);
    raw_reserve(old_balance,2);
    int i = 0;
    while (i < count) {
      deploy_item(next + i,item,sender);
      i += 1;
    }
    send_value(treasury,count * PRICE,1);
    save_data(owner,next + count,content,item,royalty,treasury,paused,revealed,commitment);
    send_value(sender,0,130);
    ;; 128+2: refund remainder; ignore uneconomic dust.
    return ();
  }
  if (op == REVEAL_OP) {
    cell final_content = body~load_ref();
    body.end_parse();
    check_reveal(final_content,revealed,commitment);
    save_data(owner,next,final_content,item,royalty,treasury,paused,1,commitment);
    return ();
  }
  if (op == SWEEP_OP) {
    throw_unless(706,equal_slices(sender,treasury));
    body.end_parse();
    raw_reserve(KEEP_BALANCE,2);
    send_value(treasury,0,130);
    return ();
  }
  throw_unless(401,equal_slices(sender,owner));
  if ((op == 0x50415553) | (op == 0x554e5053)) {
    body.end_parse();
    int new_paused = 0;
    if (op == 0x554e5053) {
      throw_unless(705,next > 0);
    }
    else {
      new_paused = 1;
    }
    save_data(owner,next,content,item,royalty,treasury,new_paused,revealed,commitment);
    return ();
  }
  if (op == 3) {
    slice new_owner = body~load_msg_addr();
    body.end_parse();
    throw_unless(712,slice_bits(new_owner) == 267);
    save_data(new_owner,next,content,item,royalty,treasury,paused,revealed,commitment);
    return ();
  }
  ;; No arbitrary content editing, no royalty edits, no set_code/upgrade operation.
  throw(0xffff);
}
(int,cell,slice) get_collection_data() method_id  {
  var (owner,next,content,_,_,_,_,_,_) = load_data();
  slice cs = content.begin_parse();
  return (next,cs~load_ref(),owner);
}
slice get_nft_address_by_index(int index) method_id  {
  throw_unless(702,(index >= 0) & (index < SUPPLY));
  var (_,_,_,item,_,_,_,_,_) = load_data();
  return item_address(item_init(index,item));
}
cell get_nft_content(int index,cell individual) method_id  {
  throw_unless(702,(index >= 0) & (index < SUPPLY));
  throw_unless(710,cell_hash(individual) == cell_hash(item_content(index)));
  var (_,_,content,_,_,_,_,_,_) = load_data();
  slice cs = content.begin_parse();
  cs~load_ref();
  slice common = cs~load_ref().begin_parse();
  return begin_cell().store_uint(1,8).store_slice(common).store_ref(individual).end_cell();
}
(int,int,int,int) get_mint_state() method_id  {
  var (_,next,_,_,_,_,paused,_,_) = load_data();
  return (next,SUPPLY,PRICE,paused);
}
(int,int,slice) royalty_params() method_id  {
  var (_,_,_,_,royalty,_,_,_,_) = load_data();
  slice s = royalty.begin_parse();
  return (s~load_uint(16),s~load_uint(16),s~load_msg_addr());
}
(int,slice) get_creator_reservation() method_id  {
  var (_,next,_,_,_,treasury,_,_,_) = load_data();
  return (next > 0,treasury);
}
(int,int,int) get_reveal_state() method_id  {
  var (_,_,_,_,_,_,_,revealed,commitment) = load_data();
  return (REVEAL_AT,revealed,commitment);
}
